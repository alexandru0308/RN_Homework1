import pathlib
import math


def load_system(path: pathlib.Path) -> tuple[list[list[float]], list[float]]:
    A = []
    B = []
    signs = ["+", "-", "=", "*", "/"]
    with path.open("r") as file:
        for line in file:
            current_row = []
            temp = line.split(" ")
            B.append(temp[-1])
            current_row.append(temp[0])
            for i in range(2, len(temp) - 1):
                if temp[i] not in signs:
                    if temp[i - 1] == "-":
                        current_row.append("-" + temp[i])
                    elif temp[i - 1] == "+":
                        current_row.append("+" + temp[i])
            A.append(current_row)
    for i in range(len(A)):
        for j in range(len(A[i])):
            if A[i][j].isalpha():
                A[i][j] = "1"
            if len(A[i][j]) > 1:
                A[i][j] = A[i][j][:-1]
                if (not (A[i][j].isalnum())) and (len(A[i][j]) == 1):
                    A[i][j] += "1"
    for i in range(len(A)):
        for j in range(len(A[i])):
            A[i][j] = float(A[i][j])

    for i in range(len(B)):
        B[i] = float(B[i])
    return A, B


def determinant(matrix: list[list[float]]) -> float:
    return (
        matrix[0][0] * (matrix[1][1] * matrix[2][2] - matrix[1][2] * matrix[2][1])
        - matrix[0][1] * (matrix[1][0] * matrix[2][2] - matrix[1][2] * matrix[2][0])
        + matrix[0][2] * (matrix[1][0] * matrix[2][1] - matrix[1][1] * matrix[2][0])
    )


def trace(matrix: list[list[float]]) -> float:
    return matrix[0][0] + matrix[1][1] + matrix[2][2]


def norm(vector: list[float]) -> float:
    return math.sqrt(vector[0] ** 2 + vector[1] ** 2 + vector[2] ** 2)


def transpose(matrix: list[list[float]]) -> list[list[float]]:
    rows = len(matrix)
    columns = len(matrix[0])

    matrix_t = []
    for i in range(columns):
        new_row = []
        for j in range(rows):
            new_row.append(matrix[j][i])
        matrix_t.append(new_row)
    return matrix_t


def multiply(matrix: list[list[float]], vector: list[float]) -> list[float]:
    result = []
    for i in range(len(matrix)):
        row_sum = 0.0
        for j in range(len(vector)):
            row_sum += matrix[i][j] * vector[j]
    result.append(row_sum)
    return result


def solve_cramer(matrix: list[list[float]], vector: list[float]) -> list[float]:
    det_A = determinant(matrix)
    Ax = [row[:] for row in matrix]
    Ay = [row[:] for row in matrix]
    Az = [row[:] for row in matrix]
    for i in range(len(vector)):
        Ax[i][0] = vector[i]
        Ay[i][1] = vector[i]
        Az[i][2] = vector[i]
    x = determinant(Ax) / det_A
    y = determinant(Ay) / det_A
    z = determinant(Az) / det_A
    return [x, y, z]


def minor(matrix: list[list[float]], i: int, j: int) -> list[list[float]]:
    return [
        [matrix[row][col] for col in range(len(matrix[row])) if col != j]
        for row in range(len(matrix))
        if row != i
    ]


def cofactor(matrix: list[list[float]]) -> list[list[float]]:
    cof_matrix = []
    for i in range(len(matrix)):
        cof_row = []
        for j in range(len(matrix[i])):
            M = minor(matrix, i, j)
            det_M = M[0][0] * M[1][1] - M[0][1] * M[1][0]
            sign = (-1) ** (i + j)
            cof_row.append(sign * det_M)
        cof_matrix.append(cof_row)
    return cof_matrix


def adjoint(matrix: list[list[float]]) -> list[list[float]]:
    return transpose(cofactor(matrix))


def solve(matrix: list[list[float]], vector: list[float]) -> list[float]:
    det_A = determinant(matrix)
    adj_A = adjoint(matrix)

    inv_A = []
    for i in range(len(adj_A)):
        inv_row = []
        for j in range(len(adj_A[i])):
            inv_row.append(adj_A[i][j] / det_A)
        inv_A.append(inv_row)

    return multiply(inv_A, vector)


A, B = load_system(pathlib.Path("system.txt"))
print(f"{A=} {B=}")
print(f"{determinant(A)=}")
print(f"{trace(A)=}")
print(f"{norm(B)=}")
print(f"{transpose(A)=}")
print(f"{multiply(A, B)=}")
print(f"{solve_cramer(A, B)=}")
print(f"{solve(A, B)=}")
